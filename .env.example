# Voltway — sample eMobility web app on the Phevnix eMSP API.
# Copy to .env and fill in. Vite reads VITE_* at dev/build time.

# Your publishable eMSP API key (pr_pk_...). Mint one at https://app.proranked.com/api-keys
# Publishable keys are read-only until a driver logs in — safe to ship in a client app.
VITE_EMSP_API_KEY=pr_pk_live_replace_me

# Which gateway Vite proxies /emsp/* to (avoids CORS in dev).
#   Prod: https://api.proranked.com   <- use this
#   (api-v2.phevnix.com is a legacy alias that still resolves)
VITE_EMSP_BASE_URL=https://api.proranked.com

# ── CLI reference demo (examples/cli-demo.ts) only ──
DRIVER_EMAIL=driver@example.com
DRIVER_PASSWORD=replace_me
REGISTER=false
