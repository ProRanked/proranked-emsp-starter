# Voltway — sample eMobility web app on the Phevnix eMSP API.
# Copy to .env and fill in. Vite reads VITE_* at dev/build time.

# Your publishable eMSP API key (pr_pk_...). Mint one at https://app.proranked.com/api-keys
# Publishable keys are read-only until a driver logs in — safe to ship in a client app.
VITE_EMSP_API_KEY=pr_pk_live_replace_me

# Which gateway Vite proxies /emsp/* to (avoids CORS in dev).
#   Prod: https://api.proranked.com   <- use this
#   (api-v2.phevnix.com is a legacy alias that still resolves)
VITE_EMSP_BASE_URL=https://api.proranked.com

# ── Make it YOUR brand (white-label, no code changes) ─────────────────────────
# Set these and the app re-skins itself: accent colours, page title, favicon, the
# sign-in screen, and every *-volt Tailwind utility.
#
# QUOTE THE HEX COLOURS. An unquoted value starting with '#' is read as a comment,
# so the variable comes through EMPTY and the app silently falls back to the default
# brand — no error, no warning. This is the easiest thing to get wrong here.
VITE_BRAND_NAME=Voltway
VITE_BRAND_TAGLINE=Charge anywhere. Pay your way.
VITE_BRAND_PRIMARY="#2ee6a6"
VITE_BRAND_SECONDARY="#1d8c66"
# Optional absolute URL to your logo; blank uses the built-in bolt mark.
VITE_BRAND_LOGO=

# ── CLI reference demo (examples/cli-demo.ts) only ──
DRIVER_EMAIL=driver@example.com
DRIVER_PASSWORD=replace_me
REGISTER=false
