{
  "name": "phevnix-emsp-sample-app",
  "version": "0.2.0",
  "description": "Voltway — a sample driver eMobility web app built on the Phevnix eMSP API (Backend-as-a-Service).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit || tsc -p tsconfig.json --noEmit",
    "cli-demo": "node --experimental-strip-types examples/cli-demo.ts"
  },
  "keywords": [
    "phevnix",
    "ev-charging",
    "emsp",
    "backend-as-a-service",
    "react",
    "sample"
  ],
  "license": "MIT",
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
