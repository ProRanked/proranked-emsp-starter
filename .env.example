# Phevnix eMSP sample app — copy to .env and fill in.
# Load it however you like (e.g. `node --env-file=.env --experimental-strip-types src/demo.ts`).

# Gateway base URL. Lab: https://api.phevnix.cloud  •  Prod: https://api-v2.phevnix.com
EMSP_BASE_URL=https://api.phevnix.cloud

# Your publishable eMSP API key (phx_...). Mint one in the Portal → Developer page.
# Publishable keys are read-only until a driver logs in; safe to embed in client apps.
EMSP_API_KEY=phx_replace_me

# A driver account on the network the key belongs to.
DRIVER_EMAIL=driver@example.com
DRIVER_PASSWORD=replace_me

# Set to "true" on first run to register the driver before logging in.
REGISTER=false

# Geo-search origin for "chargers near me" (defaults to San Juan, PR).
LAT=18.4248
LNG=-66.0758
