{
  "name": "phevnix-emsp-sample-app",
  "version": "0.2.0",
  "description": "Voltway — a sample driver eMobility web app built on the Phevnix eMSP API (Backend-as-a-Service).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit || tsc -p tsconfig.json --noEmit",
    "cli-demo": "node --experimental-strip-types examples/cli-demo.ts",
    "sim": "node tools/ocpp-sim.mjs"
  },
  "keywords": [
    "phevnix",
    "ev-charging",
    "emsp",
    "backend-as-a-service",
    "react",
    "sample"
  ],
  "license": "MIT",
  "dependencies": {
    "@stripe/react-stripe-js": "^3.10.0",
    "@stripe/stripe-js": "^5.10.0",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "ws": "^8.18.0"
  }
}
